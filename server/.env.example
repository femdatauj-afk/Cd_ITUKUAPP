# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================

# Server Environment
NODE_ENV="development"
PORT="4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3002,http://127.0.0.1:3003"

# ========================================
# DATABASE CONFIGURATION
# ========================================

# PostgreSQL
DATABASE_URL="postgresql://itukuapp_user:itukuapp_password@localhost:55432/itukuapp_db?schema=public"
POSTGRES_DB="itukuapp_db"
POSTGRES_USER="itukuapp_user"
POSTGRES_PASSWORD="itukuapp_password"

# ========================================
# REDIS CONFIGURATION
# ========================================

REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ========================================
# JWT AUTHENTICATION
# ========================================

# Secret key for JWT token generation (use strong random string in production)
JWT_SECRET="itukuapp-dev-secret"
JWT_EXPIRATION="7d"

# ========================================
# EMAIL CONFIGURATION
# ========================================

# SMTP Settings for email notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@itukuapp.com"

# ========================================
# AUTHENTICATION SETTINGS
# ========================================

# OTP (One-Time Password) expiration in seconds
OTP_EXPIRATION="300"

# Email verification link expiration in seconds (86400 = 24 hours)
EMAIL_VERIFICATION_EXPIRATION="86400"

# ========================================
# MEDIA STORAGE CONFIGURATION
# ========================================

# Storage Provider: "local" or "s3"
# local: Files stored in public/uploads directory
# s3: Files stored in AWS S3 bucket
MEDIA_STORAGE_PROVIDER="local"

# Storage bucket/directory name
MEDIA_STORAGE_BUCKET="itukuapp-media"
MEDIA_CDN_BASE_URL="http://localhost:4000"

# CDN Base URL for accessing files
# For local storage: http://localhost:3001 (served by Next.js)
# For S3 with CloudFront: https://d123abc.cloudfront.net
# For S3 direct: https://itukuapp-media.s3.us-east-1.amazonaws.com
MEDIA_CDN_BASE_URL="http://localhost:3001"

# ========================================
# AWS S3 CONFIGURATION (when MEDIA_STORAGE_PROVIDER="s3")
# ========================================

# AWS Access Key ID for S3 programmatic access
# Create via IAM console: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=""

# AWS Secret Access Key (keep this secret!)
AWS_SECRET_ACCESS_KEY=""

# AWS Region where S3 bucket is located
# Examples: us-east-1, eu-west-1, ap-southeast-1
AWS_REGION="us-east-1"

# ========================================
# FEATURE FLAGS
# ========================================

# Enable/disable features (future use)
# FEATURE_VERIFICATION_REQUIRED="false"
# FEATURE_NOTIFICATIONS_ENABLED="true"
